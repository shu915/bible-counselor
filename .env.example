# 実際の値は .env.local に置く(コミットしない)

# OpenRouter(箇所の選択・本文・解説・結論を書く LLM)
OPENROUTER_API_KEY=
# 箇所を選び、本文・解説・結論を書くモデル(聖書の知識と、書く力が要る仕事)。省略すると OPENROUTER_CHAT_MODEL と同じ
# OPENROUTER_WRITING_MODEL=
# 上の予備のモデル。省略すると google/gemini-4-hydrogen
# OPENROUTER_CHAT_MODEL=

# 回数制限(docs/rate-limit.md)。IP を、元に戻せない形(HMAC-SHA256)にして数えるための、秘密の値。
# 本番では必須(ない場合は、**相談のたびに、500 で失敗する**。起動時には気づけないので、デプロイ後の、最初の確認項目)。
# 長いランダムな文字列にする。**変えると、当日の枠がリセットされる**。開発では、省略できる
# RATE_LIMIT_SALT=
# 1日の上限。省略すると、本番は IP あたり 5回・全体 100回、開発は事実上、制限なし
# RATE_LIMIT_PER_IP_PER_DAY=
# RATE_LIMIT_GLOBAL_PER_DAY=

# 回数を数える保管先(Upstash Redis)。本番では必須(ない場合は、相談のたびに、500 で失敗する)。
# Vercel の Marketplace から Upstash を追加すると、環境変数が入る(名前は、UPSTASH_REDIS_REST_* か KV_REST_API_*。どちらでも読む)。
# 開発では、省略できる(メモリの中で数える。再起動で消える)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
